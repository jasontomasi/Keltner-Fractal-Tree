//─────────────────────────────────────────────
// K3–K33 crossover box generation (S/R Zones)
//─────────────────────────────────────────────
//dc_tf         = input.timeframe("2D", "S/R Zone Detection", options=["5", "15", "30", "60", "240", "D", "2D", "W", "M", "12M"])

// if dc_draw_boxes and anyTFcross
