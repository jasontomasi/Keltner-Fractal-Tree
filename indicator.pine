crossEMAK2K22    = ta.cross(K2EMA, K22EMA)
crossEMAK4K44    = ta.cross(K4EMA, K44EMA)
crossEMAK4K22    = ta.cross(K4EMA, K22EMA)
crossEMAK2K44    = ta.cross(K2EMA, K44EMA)
crossEMAK22K44   = ta.cross(K22EMA, K44EMA)


//─────────────────────────────────────────
// EMA CROSSOVER BODY ZONES
// Uses two horizontal lines + linefill so the zone can extend.right,
// avoiding large future bar_index projection limits from box.new().
//─────────────────────────────────────────
var line[] crossZoneTopLines = array.new_line()
var line[] crossZoneBotLines = array.new_line()
var linefill[] crossZoneFills = array.new_linefill()
var float[] crossZoneTops = array.new_float()
var float[] crossZoneBots = array.new_float()
const int MAX_CROSS_ZONES = 120   // each zone uses 2 lines + 1 linefill; keep margin below TV line limits

// Returns true when the candidate zone overlaps any already-drawn
// EMA crossover zone in price. Since existing zones extend.right,
// any later zone with overlapping price would visually overlap.
// First-drawn zones take precedence because overlapping new ones are skipped.
f_crossZoneOverlapsRegistry(_top, _bot) =>
    sz = array.size(crossZoneTops)
    hit = false
    if sz > 0
        for i = 0 to sz - 1
            existingTop = array.get(crossZoneTops, i)
            existingBot = array.get(crossZoneBots, i)
            priceRangeOverlaps = _bot <= existingTop and _top >= existingBot
            if priceRangeOverlaps
                hit := true
    hit

f_trackCrossZone(_topLine, _botLine, _fill, _top, _bot) =>
    array.push(crossZoneTopLines, _topLine)
    array.push(crossZoneBotLines, _botLine)
    array.push(crossZoneFills, _fill)
    array.push(crossZoneTops, _top)
    array.push(crossZoneBots, _bot)
    if array.size(crossZoneTopLines) > MAX_CROSS_ZONES
        line.delete(array.shift(crossZoneTopLines))
        line.delete(array.shift(crossZoneBotLines))
        linefill.delete(array.shift(crossZoneFills))
        array.shift(crossZoneTops)
        array.shift(crossZoneBots)

// Returns true when the candidate zone (_top/_bot) lies within _tolerance
// price distance of any already-drawn EMA crossover zone. This lets the
// user configure a minimum spacing (in price/tick terms) so that new
// rectangles are not drawn too close to existing ones, independent of
// the price-range overlap check performed by f_crossZoneOverlapsRegistry.
f_crossZoneWithinProximity(_top, _bot, _tolerance) =>
    sz  = array.size(crossZoneTops)
    hit = false
    if sz > 0 and _tolerance > 0
        for i = 0 to sz - 1
            existingTop = array.get(crossZoneTops, i)
            existingBot = array.get(crossZoneBots, i)
            // Distance between the candidate zone and the existing zone.
            // 0 when the ranges overlap, otherwise the gap between them.
            gap = _bot > existingTop ? _bot - existingTop : (existingBot > _top ? existingBot - _top : 0.0)
            if gap < _tolerance
                hit := true
    hit

// Name kept for compatibility with the existing f_drawCrossBox(...) calls.
f_drawCrossBox(_cond, _col) =>
    // Doji filter: skip drawing the box when the current candle's open-close
    // body is below the configured percentage of the candle's high-low range,
    // but only when filterDojiCrossBox is enabled.
    candleRangeCrossBox = high - low
    ocPctCrossBox = candleRangeCrossBox > 0 ? math.abs(close - open) / candleRangeCrossBox * 100.0 : 100.0
    isDojiCrossBox = filterDojiCrossBox and (ocPctCrossBox < crossBoxDojiOCpct)
    if _cond and drawCrossRectangles and not isDojiCrossBox
        newTop = math.max(open, close)
        newBot = math.min(open, close)
        if not f_crossZoneOverlapsRegistry(newTop, newBot) and not f_crossZoneWithinProximity(newTop, newBot, crossZoneProximityTicks * syminfo.mintick)
            topLine = line.new(bar_index, newTop, bar_index + 1, newTop, xloc=xloc.bar_index, extend=extend.right, color=_col, style=line.style_solid, width=1)
            botLine = line.new(bar_index, newBot, bar_index + 1, newBot, xloc=xloc.bar_index, extend=extend.right, color=_col, style=line.style_solid, width=1)
            zoneFill = linefill.new(topLine, botLine, color.new(_col, 75))
            f_trackCrossZone(topLine, botLine, zoneFill, newTop, newBot)


// DEFINITIONS
// f_drawCrossBox(crossEMAK1K2 and showBoxK1K2, ema1crosscolour)
f_drawCrossBox(crossEMAK1K11 and showBoxK1K11, ema1crosscolour)
f_drawCrossBox(crossEMAK2K22 and showBoxK2K22, ema2crosscolour)
f_drawCrossBox(crossEMAK4K44 and showBoxK4K44, ema4crosscolour)
f_drawCrossBox(crossEMAK2K44 and showBoxK2K44, emaK4K22crosscolour)
f_drawCrossBox(crossEMAK4K22 and showBoxK4K22, emaK4K22crosscolour)
f_drawCrossBox(crossEMAK22K44 and showBoxK22K44, emaK22K44crosscolour)

