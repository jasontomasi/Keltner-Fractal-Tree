// K-Band Gap detection candles (always use selectedperiod1)
//─────────────────────────────────────────────
gapOpen  = request.security(syminfo.tickerid, selectedperiod1, open,  lookahead=barmerge.lookahead_off)
gapClose = request.security(syminfo.tickerid, selectedperiod1, close, lookahead=barmerge.lookahead_off)

// Doji periods (HTF candles)
//─────────────────────────────────────────────
dojiTF1_Open  = request.security(syminfo.tickerid, dojiTF1, open,  lookahead=barmerge.lookahead_off)
dojiTF1_Close = request.security(syminfo.tickerid, dojiTF1, close, lookahead=barmerge.lookahead_off)
dojiTF1_High  = request.security(syminfo.tickerid, dojiTF1, high,  lookahead=barmerge.lookahead_off)
dojiTF1_Low   = request.security(syminfo.tickerid, dojiTF1, low,   lookahead=barmerge.lookahead_off)
dojiTF1_Time  = request.security(syminfo.tickerid, dojiTF1, time,  lookahead = barmerge.lookahead_off)

// For SR zone boxes
//htfOpen  = request.security(syminfo.tickerid, selectedperiod2, open,  lookahead=barmerge.lookahead_off)
//htfClose = request.security(syminfo.tickerid, selectedperiod2, close, lookahead=barmerge.lookahead_off)

//─────────────────────────────────────────────
// Keltner function
//─────────────────────────────────────────────
f_kc(_candlesrc, _emaLen, _atrLen, _mult) =>
    basis = ta.ema(_candlesrc, _emaLen)
    atrVal = ta.atr(_atrLen)
    upper = basis + _mult * atrVal
    lower = basis - _mult * atrVal
    [basis, upper, lower]

// HTF fetch wrapper — returns Keltner tuple from higher timeframe.
// NOTE: because request.security resolves only once per chart bar,
//       all signals derived from these values are confirmed on
//       HTF candle close (no repainting).
f_fetchKC(_tf, _period, _mult) =>
    request.security(syminfo.tickerid, _tf, f_kc(close, _period, atrlength, _mult), lookahead=barmerge.lookahead_off)

//─────────────────────────────────────────────
// Retrieve Keltner sets (primary W + 2D)
//─────────────────────────────────────────────
[K1EMA,  K1Upper,  K1Lower]  = f_fetchKC(selectedperiod1, ema1_period, ema1_multi)
[K2EMA,  K2Upper,  K2Lower]  = f_fetchKC(selectedperiod1, ema2_period, ema2_multi)

// Second K2 band set on selectedperiod1b — used ONLY for the band-order
// label engine (no plots). HTF-secure: signals confirm on TF2 candle close.
[K2EMAb, K2Upperb, K2Lowerb] = f_fetchKC(selectedperiod1b, ema2_period, ema2_multi)
tf2Time   = request.security(syminfo.tickerid, selectedperiod1b, time, lookahead=barmerge.lookahead_off)
newTF2bar = tf2Time != tf2Time[1]
// New-candle flag for selectedperiod1 — used so the TF1 pullback/shifties
// instance evaluates on confirmed (closed) candles, symmetric with TF2.
// This makes selectedperiod1 and selectedperiod1b fully interchangeable.
tf1Time   = request.security(syminfo.tickerid, selectedperiod1, time, lookahead=barmerge.lookahead_off)
newTF1bar = tf1Time != tf1Time[1]
[K3EMA,  K3Upper,  K3Lower]  = f_fetchKC(selectedperiod1, ema3_period, ema3_multi)
[K4EMA,  K4Upper,  K4Lower]  = f_fetchKC(selectedperiod3, ema4_period, ema4_multi)
[K5EMA,  K5Upper,  K5Lower]  = f_fetchKC(selectedperiod4, ema5_period, ema5_multi)
[K6EMA,  K6Upper,  K6Lower]  = f_fetchKC(selectedperiod1, ema6_period, ema6_multi)

[K11EMA, K11Upper, K11Lower] = f_fetchKC(selectedperiod2, ema1_period, ema1_multi)
[K22EMA, K22Upper, K22Lower] = f_fetchKC(selectedperiod2, ema2_period, ema2_multi)
[K33EMA, K33Upper, K33Lower] = f_fetchKC(selectedperiod2, ema3_period, ema3_multi)
[K44EMA, K44Upper, K44Lower] = f_fetchKC(selectedperiod2, ema4_period, ema4_multi)
[K55EMA, K55Upper, K55Lower] = f_fetchKC(selectedperiod2, ema5_period, ema5_multi)
[K66EMA, K66Upper, K66Lower] = f_fetchKC(selectedperiod2, ema6_period, ema6_multi)

//─────────────────────────────────────────────
// Extra K3-based Keltner sets for D, 4H, M (multi-HTF broad match)
//─────────────────────────────────────────────
[K3D_EMA,  K3D_Upper,  K3D_Lower]  = f_fetchKC("D",   ema3_period, ema3_multi)
[K34H_EMA, K34H_Upper, K34H_Lower] = f_fetchKC("240", ema3_period, ema3_multi)
[K3M_EMA,  K3M_Upper,  K3M_Lower]  = f_fetchKC("M",   ema3_period, ema3_multi)

//─────────────────────────────────────────────
// Plot Keltner channels
//─────────────────────────────────────────────
plot(K1EMA,   color=ema1colour,  title="K1 EMA",   linewidth=2, display=drawEMAs ? display.all : display.none)
plot(K1Upper, color=ema1Kbands,  title="K1 Upper", linewidth=1, display=drawKbands ? display.all : display.none)
plot(K1Lower, color=ema1Kbands,  title="K1 Lower", linewidth=1, display=drawKbands ? display.all : display.none)

