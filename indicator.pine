//hitsBands2 = f_hitsAnyBand(dojiLevel2, allBands)

//dojiDoubleHitsAnyBand = hitsBands1 or hitsBands2
//dojiDoubleHitsAnyBand = hitsBands1
// foundDoji             = (candleDoji1 or candleDoji2) and dojiDoubleHitsAnyBand



//─────────────────────────────────────────────
// TRUE HTF CROSSOVER ENGINE (zero false positives)
//─────────────────────────────────────────────
// We must detect crossovers ON THE HTF, not on chart TF.
// We do this by comparing previous and current HTF values.
var float prev_K3Upper  = na
var float prev_K33Upper = na
var float prev_K3Lower  = na
var float prev_K33Lower = na
var float prev_K2Upper  = na
var float prev_K4Upper  = na
var float prev_K5Upper  = na
var float prev_K11Upper = na
var float prev_K22Upper = na
var float prev_K2Lower  = na
var float prev_K4Lower  = na
var float prev_K5Lower  = na
var float prev_K11Lower = na
var float prev_K22Lower = na

// True high-level crossover detection
// NOTE: these signals confirm only when the HTF candle has closed,
//       because prev_* is updated AFTER the comparison each bar.
trueCross_K3topK33top = not na(prev_K3Upper) and not na(prev_K33Upper) and (prev_K3Upper < prev_K33Upper and K3Upper > K33Upper or prev_K3Upper > prev_K33Upper and K3Upper < K33Upper)
trueCross_K3lowK33low = not na(prev_K3Lower) and not na(prev_K33Lower) and (prev_K3Lower < prev_K33Lower and K3Lower > K33Lower or prev_K3Lower > prev_K33Lower and K3Lower < K33Lower)
trueCross_K2topK11top = not na(prev_K2Upper)  and not na(prev_K11Upper) and (prev_K2Upper  < prev_K11Upper and K2Upper  > K11Upper or prev_K2Upper  > prev_K11Upper and K2Upper  < K11Upper)
trueCross_K2lowK11low = not na(prev_K2Lower)  and not na(prev_K11Lower) and (prev_K2Lower  < prev_K11Lower and K2Lower  > K11Lower or prev_K2Lower  > prev_K11Lower and K2Lower  < K11Lower)
trueCross_K2topK22top = not na(prev_K2Upper)  and not na(prev_K22Upper) and (prev_K2Upper  < prev_K22Upper and K2Upper  > K22Upper or prev_K2Upper  > prev_K22Upper and K2Upper  < K22Upper)
trueCross_K2lowK22low = not na(prev_K2Lower)  and not na(prev_K22Lower) and (prev_K2Lower  < prev_K22Lower and K2Lower  > K22Lower or prev_K2Lower  > prev_K22Lower and K2Lower  < K22Lower)
trueCross_K5topK22top = not na(prev_K5Upper)  and not na(prev_K22Upper) and (prev_K5Upper  < prev_K22Upper and K5Upper  > K22Upper or prev_K5Upper  > prev_K22Upper and K5Upper  < K22Upper)
trueCross_K5lowK22low = not na(prev_K5Lower)  and not na(prev_K22Lower) and (prev_K5Lower  < prev_K22Lower and K5Lower  > K22Lower or prev_K5Lower  > prev_K22Lower and K5Lower  < K22Lower)
trueCross_K5topK11top = not na(prev_K5Upper)  and not na(prev_K11Upper) and (prev_K5Upper  < prev_K11Upper and K5Upper  > K11Upper or prev_K5Upper  > prev_K11Upper and K5Upper  < K11Upper)
trueCross_K5lowK11low = not na(prev_K5Lower)  and not na(prev_K11Lower) and (prev_K5Lower  < prev_K11Lower and K5Lower  > K11Lower or prev_K5Lower  > prev_K11Lower and K5Lower  < K11Lower)
trueCross_K4topK11top = not na(prev_K4Upper)  and not na(prev_K11Upper) and (prev_K4Upper  < prev_K11Upper and K4Upper  > K11Upper or prev_K4Upper  > prev_K11Upper and K4Upper  < K11Upper)
trueCross_K4lowK11low = not na(prev_K4Lower)  and not na(prev_K11Lower) and (prev_K4Lower  < prev_K11Lower and K4Lower  > K11Lower or prev_K4Lower  > prev_K11Lower and K4Lower  < K11Lower)


// Update HTF memory
prev_K3Upper  := K3Upper
prev_K33Upper := K33Upper
prev_K3Lower  := K3Lower
prev_K33Lower := K33Lower
prev_K2Upper  := K2Upper
prev_K4Upper  := K4Upper
prev_K5Upper  := K5Upper
prev_K11Upper := K11Upper
prev_K22Upper := K22Upper
prev_K2Lower  := K2Lower
prev_K4Lower  := K4Lower
prev_K5Lower  := K5Lower
prev_K11Lower := K11Lower
prev_K22Lower := K22Lower

// Final doji + crossover condition (HTF-secure)
foundDoji1 = (candleDoji1) and (trueCross_K3topK33top or trueCross_K3lowK33low)
foundDoji2 = (candleDoji2) and (trueCross_K2topK11top or trueCross_K2lowK11low)
foundDoji3 = (candleDoji3) and (trueCross_K2topK22top or trueCross_K2lowK22low)
foundDoji4 = (candleDoji4) and (trueCross_K5topK22top or trueCross_K5lowK22low)
foundDoji5 = (candleDoji5) and (trueCross_K5topK11top or trueCross_K5lowK11low)
foundDoji6 = (candleDoji6) and (trueCross_K4topK11top or trueCross_K4lowK11low)
//foundDoji7 = (candleDoji7) and (trueCross_K3topK33top or trueCross_K3lowK33low)

barcolor(foundDoji1 ? showDoji1color : na)
barcolor(foundDoji2 ? showDoji2color : na)
barcolor(foundDoji3 ? showDoji3color : na)
barcolor(foundDoji4 ? showDoji4color : na)
barcolor(foundDoji5 ? showDoji5color : na)
barcolor(foundDoji6 ? showDoji6color : na)
//barcolor(foundDoji7 ? showDoji7color : na)



// BAND ORDER CONDITION (true when K5 is outermost, K22 middle, K2 innermost)
topSideOrder   = (K5Upper > K22Upper) and (K22Upper > K2Upper)
bottomSideOrder = (K5Lower < K22Lower) and (K22Lower < K2Lower)

// Shared warning counter (fed by the primary-TF imbalance logic below;
// read by every f_pullbackSignals() instance).
var int warningCounter = 0

// Alert flags
var bool alertPullbackTop    = false
var bool alertPullbackBottom = false

// Email alerts (TradingView built-in)
alertcondition(alertPullbackTop, title = "Pullback Warning (SELL)", message = "PULLBACK WARNING: SELL SIGNAL")
alertcondition(alertPullbackBottom, title = "Pullback Warning (BUY)", message = "PULLBACK WARNING: BUY SIGNAL")

//─────────────────────────────────────────────
// PULLBACK / SHIFTIES LABEL ENGINE (reusable)
// _topOrder/_botOrder : band-order booleans for this instance
// _active             : evaluation gate — pass `true` for live (chart-TF)
//                       behaviour, or a "new HTF candle" flag for HTF-secure
//                       confirmed-only signals
// _tag                : string appended to label text + alert message
// NOTE: `var` state inside this function is INDEPENDENT PER CALL SITE,
//       so adding another timeframe/pair is just one more call.
// Returns [firedTop, firedBottom, inShifties]
//─────────────────────────────────────────────
f_pullbackSignals(_topOrder, _botOrder, _active, _tag, _showShifties) =>
    var bool inWarningSeries  = false
    var bool inShiftiesSeries = false
    firedTop    = false
    firedBottom = false
    if _active
        // ENTERING A VALID SERIES (first time condition is true)
        if (_topOrder and drawPullbacks) and not (inWarningSeries)
            // Only show label if enough warnings have accumulated
            if warningCounter >= 1
                f_trackLabel(label.new(bar_index, close, "* PULLBACK * " + _tag, xloc=xloc.bar_index, yloc=yloc.abovebar, color=color.new(#ff0000, 0), textcolor=color.white, style=label.style_label_down, size=size.normal, text_formatting=text.format_bold))
                inWarningSeries := true
                firedTop := true
                alert("PULLBACK_WARNING " + _tag, alert.freq_all)
        if (_botOrder and drawPullbacks) and not (inWarningSeries)
            if warningCounter >= 1
                f_trackLabel(label.new(bar_index, close, "* PULLBACK * " + _tag, xloc=xloc.bar_index, yloc=yloc.belowbar, color=color.new(#00ff08, 0), textcolor=color.white, style=label.style_label_up, size=size.normal, text_formatting=text.format_bold))
                inWarningSeries := true
                firedBottom := true
                alert("PULLBACK_WARNING " + _tag, alert.freq_all)
        if (_botOrder or _topOrder) and (drawShifties)
            // My shifties
            if warningCounter < 1
                if not inShiftiesSeries
                    if _showShifties
                        f_trackLabel(label.new(bar_index, close, "Shift " + _tag, xloc=xloc.bar_index, yloc=yloc.belowbar, color=color.rgb(255,100,0), textcolor=color.rgb(0, 0, 0), style=label.style_label_up, size=size.normal))
                    inShiftiesSeries := true
                firedTop    := true
                firedBottom := true
                alert("PULLBACK_WARNING " + _tag, alert.freq_all)
        // EXITING THE SERIES
        if not (_topOrder or _botOrder) and inWarningSeries
            inWarningSeries := false
        if not (_topOrder or _botOrder) and inShiftiesSeries
            inShiftiesSeries := false
    [firedTop, firedBottom, inShiftiesSeries]

// TF1 — HTF-secure: evaluate only when a new selectedperiod1 candle opens,
// using the just-CLOSED candle's band values ([1]). Symmetric with TF2, so
// swapping selectedperiod1 <-> selectedperiod1b produces identical output.
tf1Tag = "(" + (selectedperiod1 == "" ? "chart" : selectedperiod1) + ")"
topSideOrder1    = (K5Upper[1] > K22Upper[1]) and (K22Upper[1] > K2Upper[1])
bottomSideOrder1 = (K5Lower[1] < K22Lower[1]) and (K22Lower[1] < K2Lower[1])
[firedTop1, firedBottom1, inShifties1] = f_pullbackSignals(topSideOrder1, bottomSideOrder1, newTF1bar, tf1Tag, showShiftTF1)

// TF2 — HTF-secure: evaluate only when a new selectedperiod1b candle opens,
// using the just-CLOSED candle's band values ([1]).
topSideOrder2    = (K5Upper[1] > K22Upper[1]) and (K22Upper[1] > K2Upperb[1])
bottomSideOrder2 = (K5Lower[1] < K22Lower[1]) and (K22Lower[1] < K2Lowerb[1])
[firedTop2, firedBottom2, inShifties2] = f_pullbackSignals(topSideOrder2, bottomSideOrder2, newTF2bar, "(" + selectedperiod1b + ")", showShiftTF2)

// ── ADD MORE TIMEFRAME/PAIR INSTANCES HERE ──
// 1. fetch the band set (f_fetchKC) if it doesn't exist yet
// 2. compute topSide/bottomSide booleans
// 3. add one f_pullbackSignals(...) call
// 4. OR its fired flags into the alert flags below

alertPullbackTop    := firedTop1    or firedTop2
alertPullbackBottom := firedBottom1 or firedBottom2

barcolor((inShifties1 and showShiftTF1) or (inShifties2 and showShiftTF2) ? drawShiftiesColor : na)




//─────────────────────────────────────────────
// Body-only imbalance detection
//─────────────────────────────────────────────

imbalanceHigh = math.max(gapOpen, gapClose)
imbalanceLow  = math.min(gapOpen, gapClose)

upperBound = math.max(K1Upper, K2Upper)
lowerBound = math.min(K1Lower, K2Lower)

imbalanceUp   = imbalanceHigh > upperBound
imbalanceDown = imbalanceLow  < lowerBound
isImbalance   = imbalanceUp or imbalanceDown

var bool wasImbalance = false
isFirstImbalance = isImbalance and not wasImbalance
wasImbalance := isImbalance

distToK1 = math.abs(close-K1EMA)
distToK2 = math.abs(close-K2EMA)
nearestEMA     = distToK1 < distToK2 ? K1EMA : K2EMA
nearestEMAText = distToK1 < distToK2 ? "K1EMA" : "K2EMA"

if (isFirstImbalance and drawImbalance1) and not ((topSideOrder and K4Upper < K1Upper) or (bottomSideOrder and K4Lower > K1Lower))
    dateLabel := label.new(bar_index, nearestEMA, str.tostring(jasonDateTime) + ": (WEAK) " + f_formatCurrency(nearestEMA), xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_right, textcolor=#ffffff, color=#8b02e6, size=size.normal, text_formatting=text.format_bold)
    f_trackLabel(dateLabel)
    f_trackLine(line.new(bar_index, close,     bar_index,   nearestEMA, xloc=xloc.bar_index, width=1, color=orderblockcolour2, style=line.style_solid))
    emaLine = line.new(bar_index,  nearestEMA,  bar_index+1, nearestEMA, xloc=xloc.bar_index, width=1, color=orderblockcolour2, style=line.style_solid)
    line.set_extend(emaLine, extend.right)
    f_trackLine(emaLine)

if (isFirstImbalance and drawImbalance2) and ((topSideOrder and K4Upper < K1Upper) or (bottomSideOrder and K4Lower > K1Lower))
    dateLabel := label.new(bar_index, nearestEMA, str.tostring(jasonDateTime) + ": (STRONG) " + f_formatCurrency(nearestEMA), xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_right, textcolor=#ffffff, color=#8b02e6, size=size.normal, text_formatting=text.format_bold)
    f_trackLabel(dateLabel)
    f_trackLine(line.new(bar_index, close,     bar_index,   nearestEMA, xloc=xloc.bar_index, width=3, color=orderblockcolour2, style=line.style_solid))
    emaLine = line.new(bar_index,  nearestEMA,  bar_index+1, nearestEMA, xloc=xloc.bar_index, width=3, color=orderblockcolour2, style=line.style_solid)
    line.set_extend(emaLine, extend.right)
    f_trackLine(emaLine)


if (isFirstImbalance) and (topSideOrder or bottomSideOrder)
    warningCounter += 1

// Candle touches the EMA line when price overlaps the EMA value
emaTouch = (low <= nearestEMA) and (high >= nearestEMA)

// Reset warningCounter on EMA line hit
if (emaTouch)
    warningCounter := 0



//─────────────────────────────────────────────────────────────
// UNIVERSAL ABOVE/BELOW-ALL-BANDS DETECTION + LINE DRAWING
//─────────────────────────────────────────────────────────────
// _open  : series float – candle open (HTF or LTF)
// _close : series float – candle close (HTF or LTF)
// _bands : array<float> – list of levels to compare against
// _col   : color – line color
// _tag   : string – label for debugging (optional)
//─────────────────────────────────────────────────────────────
f_aboveBelowAllBands(_open, _close, _bands, _col, _tag) =>
    bodyHigh = math.max(_open, _close)
    bodyLow  = math.min(_open, _close)
    aboveAll = true
    belowAll = true

    // Evaluate against ALL bands
    for i = 0 to array.size(_bands) - 1
        b = array.get(_bands, i)
        if bodyHigh <= b
            aboveAll := false
        if bodyLow >= b
            belowAll := false

    // Draw line when condition satisfied
    if aboveAll
        f_trackLine(line.new(bar_index, bodyHigh, bar_index + 1, bodyHigh, xloc=xloc.bar_index, extend=extend.right, color=_col, style=line.style_solid, width=2))

    if belowAll
        f_trackLine(line.new(bar_index, bodyLow, bar_index + 1, bodyLow, xloc=xloc.bar_index, extend=extend.right, color=_col, style=line.style_solid, width=2))

    // Return both conditions
    [aboveAll, belowAll]



// Array for checking against candles doing K band peeks on all bands simultaneously
var float[] allBandsGapOut = array.new_float()
array.clear(allBandsGapOut)

array.push(allBandsGapOut, K1EMA)
array.push(allBandsGapOut, K1Upper)
array.push(allBandsGapOut, K1Lower)
array.push(allBandsGapOut, K2EMA)
array.push(allBandsGapOut, K2Upper)
array.push(allBandsGapOut, K2Lower)
array.push(allBandsGapOut, K3EMA)
array.push(allBandsGapOut, K3Upper)
array.push(allBandsGapOut, K3Lower)
array.push(allBandsGapOut, K4EMA)
array.push(allBandsGapOut, K4Upper)
array.push(allBandsGapOut, K4Lower)
array.push(allBandsGapOut, K5EMA)
array.push(allBandsGapOut, K5Upper)
array.push(allBandsGapOut, K5Lower)
array.push(allBandsGapOut, K11EMA)
array.push(allBandsGapOut, K11Upper)
array.push(allBandsGapOut, K11Lower)
array.push(allBandsGapOut, K22EMA)
array.push(allBandsGapOut, K22Upper)
array.push(allBandsGapOut, K22Lower)
array.push(allBandsGapOut, K33EMA)
array.push(allBandsGapOut, K33Upper)
array.push(allBandsGapOut, K33Lower)

// CALL THEM LIKE THIS; NEEDS REFINING
