var float[] srgreen_prices = array.new_float()

canPlotK2topK1top = na(lastK2topK1top) or (bar_index - lastK2topK1top > 6)
canPlotK1topK2top = na(lastK1topK2top) or (bar_index - lastK1topK2top > 6)



//─────────────────────────────────────────────
// LINE LIFECYCLE REGISTRY
// TradingView caps drawable lines per script (default 500).
// We keep a FIFO queue of line IDs so oldest lines are deleted
// before the runtime limit is hit.
//─────────────────────────────────────────────
var line[] lineRegistry = array.new_line()
const int MAX_LINES = 480   // safety margin below TV limit

var label[] labelRegistry = array.new_label()
const int MAX_LABELS = 480  // safety margin below TV limit

f_trackLine(ln) =>
    array.push(lineRegistry, ln)
    if array.size(lineRegistry) > MAX_LINES
        line.delete(array.shift(lineRegistry))

f_trackLabel(lbl) =>
    array.push(labelRegistry, lbl)
    if array.size(labelRegistry) > MAX_LABELS
        label.delete(array.shift(labelRegistry))


//─────────────────────────────────────────────
// UNIVERSAL KELTNER GAP-PEEK DETECTION FOR ANY BAND PAIR
// _o = gapOpen (HTF open)
// _c = gapClose (HTF close)
// _u1, _l1 = upper/lower of first band (e.g., K1Upper/K1Lower)
// _u2, _l2 = upper/lower of second band (e.g., K2Upper/K2Lower)
// _col = line color
//─────────────────────────────────────────────
// Returns true when _price is within _dedupPct% of any value already in _arr
f_drTooClose(_price, _arr, _dedupPct) =>
    sz  = array.size(_arr)
    hit = false
    if sz > 0
        for i = 0 to sz - 1
            ref     = array.get(_arr, i)
            safeRef = math.max(math.abs(ref), syminfo.mintick)
            if math.abs(_price - ref) / safeRef * 100.0 < _dedupPct
                hit := true
    hit

f_formatCurrency(_price) =>
    rounded = math.round(_price)
    isWhole = math.abs(_price - rounded) < syminfo.mintick
    "$" + (isWhole ? str.tostring(_price, "#,##0") : str.tostring(_price, "#,##0.0000"))

f_gapPeek(_o, _c, _u1, _l1, _u2, _l2, _col) =>
    // Combined ranges
    upperLow  = math.min(_u1, _u2)
    upperHigh = math.max(_u1, _u2)
    lowerLow  = math.min(_l1, _l2)
    lowerHigh = math.max(_l1, _l2)

    // Previous-candle state
    prevBelowBoth = _o < _u1[1] and _o < _u2[1]
    prevAboveBoth = _c > _l1[1] and _c > _l2[1]

    // Peek conditions
    peekUp   = prevBelowBoth and _o > upperLow and _o < upperHigh
    peekDown = prevAboveBoth and _c < lowerHigh and _c > lowerLow

    // Execute drawing
    if (peekDown and drawSRgreen)
        lowestLower = math.min(_l1, _l2)
        if not f_drTooClose(lowestLower, srgreen_prices, drawSRgreenDedup)
            array.push(srgreen_prices, lowestLower)
            f_trackLabel(label.new(bar_index, lowestLower, str.tostring(jasonDateTime) + ": " + f_formatCurrency(lowestLower), xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_right, textcolor=#000000, color=#1E90FF, size=size.normal, text_formatting=text.format_bold))
            f_trackLine(line.new(bar_index, lowestLower, bar_index+1, lowestLower, xloc=xloc.bar_index, extend=extend.right, color=_col, style=line.style_solid, width=2))

    if (peekUp and drawSRgreen)
        highestUpper = math.max(_u1, _u2)
        if not f_drTooClose(highestUpper, srgreen_prices, drawSRgreenDedup)
            array.push(srgreen_prices, highestUpper)
            f_trackLabel(label.new(bar_index, highestUpper, str.tostring(jasonDateTime) + ": " + f_formatCurrency(highestUpper), xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_right, textcolor=#000000, color=#1E90FF, size=size.normal, text_formatting=text.format_bold))
            f_trackLine(line.new(bar_index, highestUpper, bar_index+1, highestUpper, xloc=xloc.bar_index, extend=extend.right, color=_col, style=line.style_solid, width=2))

    // Return the booleans so user can react to them
    [peekUp, peekDown]


// Keltner gap combinations
[peekUp1, peekDown1] = f_gapPeek(gapOpen, gapClose, K1Upper, K1Lower, K2Upper, K2Lower, orderblockcolour1)
[peekUp2, peekDown2] = f_gapPeek(gapOpen, gapClose, K2Upper, K2Lower, K1Upper, K1Lower, orderblockcolour1)

