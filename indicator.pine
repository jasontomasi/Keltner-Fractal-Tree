// Returns true when candle qualifies as a doji under the given thresholds
f_drIsDoji(_o, _h, _l, _c, _ocThresh, _wickThresh) =>
    totalRange = _h - _l
    result = false
    if totalRange > 0
        body    = math.abs(_c - _o)
        ocPct   = body / _o * 100.0
        wickPct = (totalRange - body) / totalRange * 100.0
        result  := ocPct < _ocThresh and wickPct > _wickThresh
    result

