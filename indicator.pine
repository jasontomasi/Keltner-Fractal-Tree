showDoji6color  = input.color(color.new(#E040FB, 0), "Doji Set #6", group='DOJI S/R ZONES')
showDoji7color  = input.color(color.new(#2E2E2E, 0), "Doji Set #7", group='DOJI S/R ZONES')
dojiBoxOpacity  = input.int(90, "Doji Box Opacity (0=solid, 100=invisible)", minval=0, maxval=100, group='DOJI S/R ZONES')


string jasonDateTime = str.format_time(time, "dd/MM/yyyy", "UTC+0")
var label dateLabel = na


// ─ DOJI ZONES & MARKERS ADD-ON INPUTS ─
