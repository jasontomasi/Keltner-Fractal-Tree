//─────────────────────────────────────────────
// DOJI BODY BOXES (open→close, extending 25 years right)
//─────────────────────────────────────────────
dojiBox_futureMs = 788922000000  // ~25 years in milliseconds
dojiBox_top      = math.max(dojiTF1_Open, dojiTF1_Close)
dojiBox_bot      = math.min(dojiTF1_Open, dojiTF1_Close)

var int[]   dojiBox_drawnTimes = array.new_int()
var float[] dojiBoxTops1 = array.new_float()
var float[] dojiBoxBots1 = array.new_float()
var float[] dojiBoxTops2 = array.new_float()
var float[] dojiBoxBots2 = array.new_float()
var float[] dojiBoxTops3 = array.new_float()
var float[] dojiBoxBots3 = array.new_float()
var float[] dojiBoxTops4 = array.new_float()
var float[] dojiBoxBots4 = array.new_float()
var float[] dojiBoxTops5 = array.new_float()
var float[] dojiBoxBots5 = array.new_float()
var float[] dojiBoxTops6 = array.new_float()
var float[] dojiBoxBots6 = array.new_float()
var float[] allDojiBoxTops = array.new_float()
var float[] allDojiBoxBots = array.new_float()
var box[]   dojiBoxRegistry = array.new_box()
var float[] dojiBoxRegistryTops = array.new_float()
var float[] dojiBoxRegistryBots = array.new_float()
const int MAX_DOJI_BOXES = 480  // safety margin below TV limit

f_removeFirstDojiPrice(_top, _bot, _tops, _bots) =>
    sz = array.size(_tops)
    removed = false
    if sz > 0
        for i = 0 to sz - 1
            if not removed and array.get(_tops, i) == _top and array.get(_bots, i) == _bot
                array.remove(_tops, i)
                array.remove(_bots, i)
                removed := true

f_trackDojiBox(_bx, _top, _bot) =>
    array.push(dojiBoxRegistry, _bx)
    array.push(dojiBoxRegistryTops, _top)
    array.push(dojiBoxRegistryBots, _bot)
    if array.size(dojiBoxRegistry) > MAX_DOJI_BOXES
        oldBox = array.shift(dojiBoxRegistry)
        oldTop = array.shift(dojiBoxRegistryTops)
        oldBot = array.shift(dojiBoxRegistryBots)
        box.delete(oldBox)
        if array.size(dojiBox_drawnTimes) > 0
            array.shift(dojiBox_drawnTimes)
        f_removeFirstDojiPrice(oldTop, oldBot, dojiBoxTops1, dojiBoxBots1)
        f_removeFirstDojiPrice(oldTop, oldBot, dojiBoxTops2, dojiBoxBots2)
        f_removeFirstDojiPrice(oldTop, oldBot, dojiBoxTops3, dojiBoxBots3)
        f_removeFirstDojiPrice(oldTop, oldBot, dojiBoxTops4, dojiBoxBots4)
        f_removeFirstDojiPrice(oldTop, oldBot, dojiBoxTops5, dojiBoxBots5)
        f_removeFirstDojiPrice(oldTop, oldBot, dojiBoxTops6, dojiBoxBots6)
        f_removeFirstDojiPrice(oldTop, oldBot, allDojiBoxTops, allDojiBoxBots)

f_dojiTimeDrawn(_t) =>
    sz  = array.size(dojiBox_drawnTimes)
    hit = false
    if sz > 0
        for i = 0 to sz - 1
            if array.get(dojiBox_drawnTimes, i) == _t
                hit := true
    hit

f_dojiPriceOverlaps(_top, _bot, _setTops, _setBots) =>
    sz  = array.size(_setTops)
    hit = false
    if sz > 0
        for i = 0 to sz - 1
            if _top >= array.get(_setBots, i) and _bot <= array.get(_setTops, i)
                hit := true
    hit

f_drawDojiBox(_top, _bot, _col, _setTops, _setBots) =>
    t = int(dojiTF1_Time)
    if not f_dojiTimeDrawn(t) and not f_dojiPriceOverlaps(_top, _bot, allDojiBoxTops, allDojiBoxBots)
        array.push(dojiBox_drawnTimes, t)
        array.push(_setTops, _top)
        array.push(_setBots, _bot)
        array.push(allDojiBoxTops, _top)
        array.push(allDojiBoxBots, _bot)
        dojiBox = box.new(dojiTF1_Time, _top, dojiTF1_Time + dojiBox_futureMs, _bot, xloc=xloc.bar_time, bgcolor=color.new(_col, dojiBoxOpacity), border_color=_col)
        f_trackDojiBox(dojiBox, _top, _bot)

if foundDoji1 and newP1
    f_drawDojiBox(dojiBox_top, dojiBox_bot, showDoji1color, dojiBoxTops1, dojiBoxBots1)
if foundDoji2 and newP1
    f_drawDojiBox(dojiBox_top, dojiBox_bot, showDoji2color, dojiBoxTops2, dojiBoxBots2)
if foundDoji3 and newP1
    f_drawDojiBox(dojiBox_top, dojiBox_bot, showDoji3color, dojiBoxTops3, dojiBoxBots3)
if foundDoji4 and newP1
    f_drawDojiBox(dojiBox_top, dojiBox_bot, showDoji4color, dojiBoxTops4, dojiBoxBots4)
if foundDoji5 and newP1
    f_drawDojiBox(dojiBox_top, dojiBox_bot, showDoji5color, dojiBoxTops5, dojiBoxBots5)
if foundDoji6 and newP1
    f_drawDojiBox(dojiBox_top, dojiBox_bot, showDoji6color, dojiBoxTops6, dojiBoxBots6)


