//─────────────────────────────────────────────
// Keltner function
//─────────────────────────────────────────────
f_kc(_candlesrc, _emaLen, _atrLen, _mult) =>
    basis = ta.ema(_candlesrc, _emaLen)
    atrVal = ta.atr(_atrLen)
    upper = basis + _mult * atrVal
    lower = basis - _mult * atrVal
    [basis, upper, lower]

// HTF fetch wrapper — returns Keltner tuple from higher timeframe.
// NOTE: because request.security resolves only once per chart bar,
//       all signals derived from these values are confirmed on
//       HTF candle close (no repainting).
f_fetchKC(_tf, _period, _mult) =>
    request.security(syminfo.tickerid, _tf, f_kc(close, _period, atrlength, _mult), lookahead=barmerge.lookahead_off)

//─────────────────────────────────────────────
