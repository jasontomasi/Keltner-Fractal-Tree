// Returns true when candle qualifies as a doji under the given thresholds
f_drIsDoji(_o, _h, _l, _c, _ocThresh, _wickThresh) =>
    totalRange = _h - _l
    result = false
    if totalRange > 0
        body    = math.abs(_c - _o)
        ocPct   = body / _o * 100.0
        wickPct = (totalRange - body) / totalRange * 100.0
        result  := ocPct < _ocThresh and wickPct > _wickThresh
    result

//───────────── DOJI DETECTION ─────────────//
// DOJI DETECTION — SET #1
// All of them: (showDoji1 or showDoji2 or showDoji3 or showDoji4 or showDoji5 or showDoji6) and (f_drIsDoji(dojiTF1_Open, dojiTF1_High, dojiTF1_Low, dojiTF1_Close, dojiTF1_OCpct, dojiTF1_WickMin))
candleDoji1 = (showDoji1) and (f_drIsDoji(dojiTF1_Open, dojiTF1_High, dojiTF1_Low, dojiTF1_Close, dojiTF1_OCpct, dojiTF1_WickMin))
candleDoji2 = (showDoji2) and (f_drIsDoji(dojiTF1_Open, dojiTF1_High, dojiTF1_Low, dojiTF1_Close, dojiTF1_OCpct, dojiTF1_WickMin))
candleDoji3 = (showDoji3) and (f_drIsDoji(dojiTF1_Open, dojiTF1_High, dojiTF1_Low, dojiTF1_Close, dojiTF1_OCpct, dojiTF1_WickMin))
candleDoji4 = (showDoji4) and (f_drIsDoji(dojiTF1_Open, dojiTF1_High, dojiTF1_Low, dojiTF1_Close, dojiTF1_OCpct, dojiTF1_WickMin))
candleDoji5 = (showDoji5) and (f_drIsDoji(dojiTF1_Open, dojiTF1_High, dojiTF1_Low, dojiTF1_Close, dojiTF1_OCpct, dojiTF1_WickMin))
candleDoji6 = (showDoji6) and (f_drIsDoji(dojiTF1_Open, dojiTF1_High, dojiTF1_Low, dojiTF1_Close, dojiTF1_OCpct, dojiTF1_WickMin))
