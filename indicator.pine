//────────────────────────────────────────────
// TRENDLINE REGISTRIES (dynamically created, one per originating event id).
// Efficiency note: on every bar we only
// need (a) each line's CURRENT price at bar_index, and (b) whether it is
// currently intersecting another line in its OWN registry. We no longer
// store/scan static creation-time yLow/yHigh bounds; instead we cache a
// live current-price + previous-price per line and detect intersections
// via a sign-flip test against the prior bar — O(n) update, O(n²) only
// within a single (small) registry for the intra-registry cross check.
//────────────────────────────────────────────
// Registries are created lazily: any positive integer index passed to
// f_getTrendlineRegistry() grows the container on demand, so there is no
// hardcoded limit on the number of registries (one per f_pairLines id).
// Pine does not support arrays of arrays directly, so each registry is a
// UDT instance holding its five tracking arrays plus its line colour.
type TrendReg
    line[]  lines
    float[] curr
    float[] prev
    float[] xPrice
    bool[]  xing
    color   col

var array<TrendReg> regAll = array.new<TrendReg>()

// Grows the registry container up to _regIndex and returns the
// (lines, currPrice, prevPrice, xPrice, isXing) array tuple for it.
f_getTrendlineRegistry(int _regIndex) =>
    while array.size(regAll) < _regIndex
        array.push(regAll, TrendReg.new(array.new_line(), array.new_float(), array.new_float(), array.new_float(), array.new_bool(), color.white))
    reg = array.get(regAll, _regIndex - 1)
    [reg.lines, reg.curr, reg.prev, reg.xPrice, reg.xing]

// Stores the colour used by a registry's lines (used for the intersection
// boxes of registries beyond the six colour inputs).
f_setTrendlineRegistryColour(int _regIndex, color _col) =>
    f_getTrendlineRegistry(_regIndex)
    reg = array.get(regAll, _regIndex - 1)
    reg.col := _col

f_registerTrendline(ln, int _regIndex) =>
    [regLines, regCurr, regPrev, regXPrice, regXing] = f_getTrendlineRegistry(_regIndex)
    array.push(regLines, ln)
    array.push(regCurr,  line.get_price(ln, bar_index))
    array.push(regPrev,  na)
    array.push(regXPrice, na)
    array.push(regXing,  false)
    f_trackLine(ln)

// Call once per bar (per registry) AFTER any new lines were registered for that bar.
// Updates every line's live current price and flags intra-registry intersections
// via a sign-flip of (price_i - price_j) between the previous bar and this bar.
f_updateTrendlineRegistry(int _regIndex) =>
    [regLines, regCurr, regPrev, regXPrice, regXing] = f_getTrendlineRegistry(_regIndex)
    sz = array.size(regLines)
    if sz > 0
        for i = 0 to sz - 1
            ln_i = array.get(regLines, i)
            prevP = array.get(regCurr, i)
            array.set(regPrev, i, prevP)
            array.set(regCurr, i, line.get_price(ln_i, bar_index))
            array.set(regXPrice, i, na)
            array.set(regXing, i, false)
        if sz > 1
            for i = 0 to sz - 2
                pi_curr = array.get(regCurr, i)
                pi_prev = array.get(regPrev, i)
                for j = i + 1 to sz - 1
                    pj_curr = array.get(regCurr, j)
                    pj_prev = array.get(regPrev, j)
                    if not na(pi_prev) and not na(pj_prev) and not na(pi_curr) and not na(pj_curr)
                        diffPrev = pi_prev - pj_prev
                        diffCurr = pi_curr - pj_curr
                        if (diffPrev == 0) or (diffCurr == 0) or (diffPrev > 0 and diffCurr < 0) or (diffPrev < 0 and diffCurr > 0)
                            crossPrice = diffCurr == 0 ? pi_curr : diffPrev == 0 ? pi_prev : pi_prev + (pi_curr - pi_prev) * (diffPrev / (diffPrev - diffCurr))
                            array.set(regXPrice, i, crossPrice)
                            array.set(regXPrice, j, crossPrice)
                            array.set(regXing, i, true)
                            array.set(regXing, j, true)

// Call once per bar, after all f_registerTrendline calls for that bar, to refresh
// live prices / intersection flags across every registry created so far.
f_updateAllTrendlineRegistries() =>
    regCount = array.size(regAll)
    if regCount > 0
        for i = 1 to regCount
            f_updateTrendlineRegistry(i)

// Returns true if ANY line in the given registry is currently intersecting
// another line within that same registry, on the current bar.
f_registryHasIntersection(int _regIndex) =>
    [regLines, regCurr, regPrev, regXPrice, regXing] = f_getTrendlineRegistry(_regIndex)
    sz = array.size(regXing)
    hit = false
    if sz > 0
        for i = 0 to sz - 1
            if array.get(regXing, i)
                hit := true
    hit

//────────────────────────────────────────────
// HYBRID PRICE-ONLY LEVEL CHECK (HTF AGNOSTIC)
// Compares _level against each line's LIVE current price (not static bounds).
// _regIndex selects which of the 6 trendline registries (1-6) to scan.
//────────────────────────────────────────────
f_dojiIntersectsAnyTrendline(_level, tolPct, int _regIndex) =>
    if na(_level)
        false
    else
        [regLines, regCurr, regPrev, regXPrice, regXing] = f_getTrendlineRegistry(_regIndex)
        sz = array.size(regCurr)
        if sz == 0
            false
        else
            hit = false
            for i = 0 to sz - 1
                price = array.get(regCurr, i)
                if not na(price)
                    tolAbs = math.abs(price) * tolPct / 100.0
                    if _level >= (price - tolAbs) and _level <= (price + tolAbs)
                        hit := true
            hit

f_trendIntersectionRegEnabled(int _regIndex) =>
    switch _regIndex
        1 => showTrendlineIntersectionReg1
        2 => showTrendlineIntersectionReg2
        3 => showTrendlineIntersectionReg3
        4 => showTrendlineIntersectionReg4
        5 => showTrendlineIntersectionReg5
        6 => showTrendlineIntersectionReg6
        // Registries beyond the six inputs are always enabled.
        => true

f_trendIntersectionRegColour(int _regIndex) =>
    switch _regIndex
        1 => trendlineIntersectionColourReg1
        2 => trendlineIntersectionColourReg2
        3 => trendlineIntersectionColourReg3
        4 => trendlineIntersectionColourReg4
        5 => trendlineIntersectionColourReg5
        6 => trendlineIntersectionColourReg6
        // Registries beyond the six inputs use the colour stored at the f_pairLines call site.
        => _regIndex >= 1 and _regIndex <= array.size(regAll) ? array.get(regAll, _regIndex - 1).col : color.white

f_drawTrendlineIntersectionBoxAtPrice(float _intersectionPrice, color _col) =>
    candleRangeTrendBox = high - low
    ocPctTrendBox = candleRangeTrendBox > 0 ? math.abs(close - open) / candleRangeTrendBox * 100.0 : 100.0
    isDojiTrendBox = filterDojiTrendlineIntersectionBox and (ocPctTrendBox < trendlineIntersectionDojiOCpct)
    didDrawTrendBox = false
    if drawTrendlineIntersectionRectangles and not isDojiTrendBox and not na(_intersectionPrice)
        bodyTop = math.max(open, close)
        bodyBot = math.min(open, close)
        distHigh = math.abs(high - _intersectionPrice)
        distLow = math.abs(low - _intersectionPrice)
        distOpen = math.abs(open - _intersectionPrice)
        distClose = math.abs(close - _intersectionPrice)
        farthestWickIsHigh = distHigh >= distLow
        closestWickIsHigh = distHigh <= distLow
        farthestBody = distOpen >= distClose ? open : close
        closestBody = distOpen <= distClose ? open : close
        newTop = trendlineIntersectionRectangleOrigin == "Far Wick" ? math.max(farthestWickIsHigh ? high : low, farthestBody) : trendlineIntersectionRectangleOrigin == "Near Wick" ? math.max(closestWickIsHigh ? high : low, closestBody) : trendlineIntersectionRectangleOrigin == "High/Low" ? high : bodyTop
        newBot = trendlineIntersectionRectangleOrigin == "Far Wick" ? math.min(farthestWickIsHigh ? high : low, farthestBody) : trendlineIntersectionRectangleOrigin == "Near Wick" ? math.min(closestWickIsHigh ? high : low, closestBody) : trendlineIntersectionRectangleOrigin == "High/Low" ? low : bodyBot
        if drawTrendIntersectionRectanglesOverlapping
            // Overlap checking disabled: draw the rectangle unconditionally.
            // It is not registered in the trend-intersection overlap registry,
            // so it never blocks, or is blocked by, other intersection rectangles.
            // It uses the existing overlapping-zone pool to stay within drawing limits.
            f_trackOverlappingCrossZone(newTop, newBot, _col)
            didDrawTrendBox := true
        else
            if not f_trendZoneOverlapsRegistry(newTop, newBot)
                f_trackTrendIntersectionZone(newTop, newBot, _col)
                didDrawTrendBox := true
    didDrawTrendBox

f_drawTrendlineIntersectionBoxesForRegistry(int _regIndex) =>
    didDrawForReg = false
    if drawTrendlineIntersectionRectangles and f_trendIntersectionRegEnabled(_regIndex)
        [regLines, regCurr, regPrev, regXPrice, regXing] = f_getTrendlineRegistry(_regIndex)
        sz = array.size(regCurr)
        if sz > 0
            regCol = f_trendIntersectionRegColour(_regIndex)
            for i = 0 to sz - 1
                if array.get(regXing, i)
                    didDrawForReg := f_drawTrendlineIntersectionBoxAtPrice(array.get(regXPrice, i), regCol) or didDrawForReg
    didDrawForReg

f_drawAllTrendlineIntersectionBoxes() =>
    regCount = array.size(regAll)
    if regCount > 0
        for i = 1 to regCount
            f_drawTrendlineIntersectionBoxesForRegistry(i)

//────────────────────────────────────────────
// Unified line-pairing function with optional mid-line
//────────────────────────────────────────────
// The _id passed to f_pairLines() is used directly as the trendline registry
// index: any positive integer gets its own pending pair slot and its own
// lazily-created registry, so there is no hardcoded limit on the number of
// pair/event combinations.
f_pairLines(int _id, bool _event, float _low, float _high, float _mid, color _col) =>
    var int[]   firstBar   = array.new_int()
    var float[] firstLow   = array.new_float()
    var float[] firstHigh  = array.new_float()
    var float[] firstMid   = array.new_float()

    while array.size(firstBar) <= _id
        array.push(firstBar,   na)
        array.push(firstLow,   na)
        array.push(firstHigh,  na)
        array.push(firstMid,   na)

    fb  = array.get(firstBar,  _id)
    fl  = array.get(firstLow,  _id)
    fh  = array.get(firstHigh, _id)
    fm  = array.get(firstMid,  _id)

    regIndex = _id

    if _event
        if na(fb)
            array.set(firstBar,  _id, bar_index)
            array.set(firstLow,  _id, _low)
            array.set(firstHigh, _id, _high)
            array.set(firstMid,  _id, _mid)
        else
            x1 = fb
            x2 = bar_index
            ext = emaTrendlineExtendRight ? extend.right : extend.both

            lnLow  = line.new(x1, fl, x2, _low,  xloc=xloc.bar_index, width=1, color=_col, style=line.style_solid, extend=ext)
            f_registerTrendline(lnLow, regIndex)
            lnHigh = line.new(x1, fh, x2, _high, xloc=xloc.bar_index, width=1, color=_col, style=line.style_solid, extend=ext)
            f_registerTrendline(lnHigh, regIndex)

            if not na(fm) and not na(_mid)
                lnMid = line.new(x1, fm, x2, _mid, xloc=xloc.bar_index, width=1, color=_col, style=line.style_solid, extend=ext)
                f_registerTrendline(lnMid, regIndex)

            f_setTrendlineRegistryColour(regIndex, _col)

            array.set(firstBar,  _id, na)
            array.set(firstLow,  _id, na)
            array.set(firstHigh, _id, na)
            array.set(firstMid,  _id, na)



if (drawEMAlines)

    crossEvent1 = (ta.cross(K1EMA, K3EMA)) and (showEMAtrendK1K3)
    crossEvent2 = (ta.cross(K2EMA, K3EMA)) and (showEMAtrendK2K3)
    crossEvent4 = (ta.cross(K11EMA, K22EMA)) and (showEMAtrendK11K22) // PERFECT
    crossEvent5 = (ta.cross(K22EMA, K33EMA)) and (showEMAtrendK22K33)
    crossEvent6 = (ta.cross(K1EMA, K2EMA)) and (showEMAtrendK1K2)
    crossEvent7 = (ta.cross(K33EMA, K3EMA) or ta.cross(K33EMA, K3Upper) or ta.cross(K33EMA, K3Lower))  and (showEMAtrendK3K33)
    crossEvent8 = (ta.cross(K33EMA, K11EMA) or ta.cross(K33EMA, K11Upper) or ta.cross(K33EMA, K11Lower)) and (showEMAtrendK11K33)
    crossEvent9 = (ta.cross(K33EMA, K2EMA) or ta.cross(K33EMA, K2Upper) or ta.cross(K33EMA, K2Lower)) and (showEMAtrendK2K33)
    crossEvent10 = (ta.cross(K44EMA, K4EMA) or ta.cross(K44EMA, K4Upper) or ta.cross(K44EMA, K4Lower)) and (showEMAtrendK4K44)

    crossEvent11 = (ta.cross(K11EMA, K1EMA)) and (showEMAtrendK1K11)
    crossEvent12 = (ta.cross(K22EMA, K2EMA)) and (showEMAtrendK2K22)
    crossEvent13 = (ta.cross(K33EMA, K3EMA)) and (showEMAtrendK3K33)
    crossEvent14 = (ta.cross(K44EMA, K4EMA)) and (showEMAtrendK4K44)
    crossEvent15 = (ta.cross(K55EMA, K5EMA)) and (showEMAtrendK5K55)
    crossEvent16 = (ta.cross(K66EMA, K6EMA)) and (showEMAtrendK6K66)


    //TODO: Jason:modify function to allow for 4x band inputs (uppers and lowers, two pairs)
    f_pairLines(7, crossEvent6, K2Lower, K2Upper, na, ema1colour)   // K1–K2
    //f_pairLines(8, crossEvent1, K11Lower, K11Upper, na, ema3colour) // K1–K3
    //f_pairLines(9, crossEvent2, K11Lower, K11Upper, na, ema3colour) // K2–K3

    f_pairLines(1, crossEvent11, K11Lower, K11Upper, na, ema1colour)  // K1–K11
    f_pairLines(2, crossEvent12, K22Lower, K22Upper, na, ema2colour)  // K2–K22
    f_pairLines(3, crossEvent13, K33Lower, K33Upper, na, ema3colour)  // K3–K33
    f_pairLines(4, crossEvent14, K44Lower, K44Upper, na, ema4colour)  // K4–K44
    f_pairLines(5, crossEvent15, K55Lower, K55Upper, na, ema5colour)  // K5–K55
    f_pairLines(6, crossEvent16, K66Lower, K66Upper, na, ema3colour)  // K6–K66

    f_pairLines(7, crossEvent4, K11Lower, K22Upper, na, ema3colour)  // K11–K22
    f_pairLines(8, crossEvent4, K11Upper, K22Lower, na, ema3colour)  // K11–K22

    f_pairLines(9,  crossEvent5, K22Lower, K33Upper, na, ema3colour)  // K22–K33
    f_pairLines(10, crossEvent5, K22Upper, K33Lower, na, ema3colour)  // K22–K22


    f_updateAllTrendlineRegistries()
    f_drawAllTrendlineIntersectionBoxes()




