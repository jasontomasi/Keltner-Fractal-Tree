// RETURNS TRUE IF price crosses OR equals ANY band
f_hitsAnyBand(_price, _bandsArray) =>
    bool hit = false
    for i = 0 to array.size(_bandsArray) - 1
        band = array.get(_bandsArray, i)
        if ta.cross(_price, band) or (_price == band)
            hit := true
    hit

