//─────────────────────────────────────────────
// DOJI RAY DETECTION  (D = white, W = gold)
// Formula:
//   OC%   = |close - open| / open × 100   < threshold
//   Wick% = (high - low - |close-open|) / (high - low) × 100  > wickThresh
//   Dedup: skip if within dedupPct% of an already-drawn ray of same type
// NOTE: if total line count exceeds TV limit (500), increase max_lines_count
//       in the indicator() declaration at the top of the script.
//─────────────────────────────────────────────

showDojiRaysD  = input.bool(false,  "Show DAILY Doji S/R?", group='DOJI RAYS')
showDojiRaysW  = input.bool(false,  "Show WEEKLY Doji S/R?", group='DOJI RAYS')
dojiRayOCpctD  = input.float(0.04, "OC% threshold — Daily",             minval=0.001, maxval=5.0,  step=0.001, group='DOJI RAYS')
dojiRayOCpctW  = input.float(0.6,  "OC% threshold — Weekly",            minval=0.001, maxval=5.0,  step=0.01,  group='DOJI RAYS')
dojiRayWickMin = input.float(94.0, "Wick% minimum",                     minval=50.0,  maxval=99.9, step=0.5,   group='DOJI RAYS')
dojiRayDedup   = input.float(1.4,  "Deduplication proximity (%)",       minval=0.0,   maxval=100.0, step=0.5,  group='DOJI RAYS')

// HTF OHLC — Daily
// NOTE: all doji-ray signals are confirmed on HTF candle close (no repainting)
dr_d_O = request.security(syminfo.tickerid, "D", open,  lookahead=barmerge.lookahead_off)
dr_d_H = request.security(syminfo.tickerid, "D", high,  lookahead=barmerge.lookahead_off)
dr_d_L = request.security(syminfo.tickerid, "D", low,   lookahead=barmerge.lookahead_off)
dr_d_C = request.security(syminfo.tickerid, "D", close, lookahead=barmerge.lookahead_off)
dr_d_T = request.security(syminfo.tickerid, "D", time,  lookahead=barmerge.lookahead_off)

// HTF OHLC — Weekly
dr_w_O = request.security(syminfo.tickerid, "W", open,  lookahead=barmerge.lookahead_off)
dr_w_H = request.security(syminfo.tickerid, "W", high,  lookahead=barmerge.lookahead_off)
dr_w_L = request.security(syminfo.tickerid, "W", low,   lookahead=barmerge.lookahead_off)
dr_w_C = request.security(syminfo.tickerid, "W", close, lookahead=barmerge.lookahead_off)
dr_w_T = request.security(syminfo.tickerid, "W", time,  lookahead=barmerge.lookahead_off)


// New HTF candle flags
dr_newD = dr_d_T != dr_d_T[1]
dr_newW = dr_w_T != dr_w_T[1]

// Price registries for dedup (persist across bars)
var float[] dr_d_prices = array.new_float()
var float[] dr_w_prices = array.new_float()

// Daily doji rays — DAILY
if showDojiRaysD and dr_newD
    if f_drIsDoji(dr_d_O, dr_d_H, dr_d_L, dr_d_C, dojiRayOCpctD, dojiRayWickMin)
        dr_mid = (dr_d_O + dr_d_C) / 2.0
        if not f_drTooClose(dr_mid, dr_d_prices, dojiRayDedup)
            array.push(dr_d_prices, dr_mid)
            f_trackLine(line.new(bar_index, dr_mid, bar_index + 1, dr_mid, xloc=xloc.bar_index, extend=extend.right, color=dojiRaysDaily, style=line.style_solid, width=1))

// Weekly doji rays — WEEKLY
if showDojiRaysW and dr_newW
    if f_drIsDoji(dr_w_O, dr_w_H, dr_w_L, dr_w_C, dojiRayOCpctW, dojiRayWickMin)
        dr_mid = (dr_w_O + dr_w_C) / 2.0
        if not f_drTooClose(dr_mid, dr_w_prices, dojiRayDedup)
            array.push(dr_w_prices, dr_mid)
            f_trackLine(line.new(bar_index, dr_mid, bar_index + 1, dr_mid, xloc=xloc.bar_index, extend=extend.right, color=dojiRaysWeekly, style=line.style_solid, width=1))

