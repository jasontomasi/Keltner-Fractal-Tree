//─────────────────────────────────────────
// EMA CROSSOVER BODY ZONES
// Uses two horizontal lines + linefill so the zone can extend.right,
// avoiding large future bar_index projection limits from box.new().
//─────────────────────────────────────────
const int MAX_CROSS_ZONES = 120   // each zone uses 2 lines + 1 linefill; keep margin below TV line limits
var line[] crossZoneTopLines = array.new_line(MAX_CROSS_ZONES)
var line[] crossZoneBotLines = array.new_line(MAX_CROSS_ZONES)
var linefill[] crossZoneFills = array.new_linefill(MAX_CROSS_ZONES)
var float[] crossZoneTops = array.new_float(MAX_CROSS_ZONES, na)
var float[] crossZoneBots = array.new_float(MAX_CROSS_ZONES, na)
var int[] crossZoneSlotState = array.new_int(1, 0)
var int[] crossZoneCountState = array.new_int(1, 0)

// Separate lightweight registry for rectangles drawn while
// drawCrossRectanglesOverlapping is enabled. These are never checked
// for overlap/proximity against anything, but are still tracked here
// purely so they get cleaned up (FIFO) once the drawable-object limits
// are approached, same as the regular cross-zone registry above.
const int MAX_OVERLAP_ZONES = 120   // each zone uses 2 lines + 1 linefill; keep margin below TV line limits
var line[] overlapZoneTopLines = array.new_line(MAX_OVERLAP_ZONES)
var line[] overlapZoneBotLines = array.new_line(MAX_OVERLAP_ZONES)
var linefill[] overlapZoneFills = array.new_linefill(MAX_OVERLAP_ZONES)
var int[] overlapZoneSlotState = array.new_int(1, 0)

const int MAX_TREND_INTERSECTION_ZONES = 120
var line[] trendIntersectionTopLines = array.new_line(MAX_TREND_INTERSECTION_ZONES)
var line[] trendIntersectionBotLines = array.new_line(MAX_TREND_INTERSECTION_ZONES)
var linefill[] trendIntersectionFills = array.new_linefill(MAX_TREND_INTERSECTION_ZONES)
var float[] trendIntersectionTops = array.new_float(MAX_TREND_INTERSECTION_ZONES, na)
var float[] trendIntersectionBots = array.new_float(MAX_TREND_INTERSECTION_ZONES, na)
var int[] trendIntersectionSlotState = array.new_int(1, 0)
var int[] trendIntersectionCountState = array.new_int(1, 0)

// Creates or reuses a pooled two-line/linefill zone slot. This avoids repeated
// line.new()/linefill.new() churn and prevents TradingView's drawing caps from
// being exceeded before the script's own fixed-size pools are recycled.
f_drawPooledCrossZone(line[] _topLines, line[] _botLines, linefill[] _fills, int _slot, float _top, float _bot, color _col) =>
    topLine = array.get(_topLines, _slot)
    botLine = array.get(_botLines, _slot)
    zoneFill = array.get(_fills, _slot)
    if na(topLine)
        topLine := line.new(bar_index, _top, bar_index + 1, _top, xloc=xloc.bar_index, extend=extend.right, color=_col, style=line.style_solid, width=1)
        array.set(_topLines, _slot, topLine)
    else
        line.set_xy1(topLine, bar_index, _top)
        line.set_xy2(topLine, bar_index + 1, _top)
        line.set_extend(topLine, extend.right)
        line.set_color(topLine, _col)
        line.set_style(topLine, line.style_solid)
        line.set_width(topLine, 1)
    if na(botLine)
        botLine := line.new(bar_index, _bot, bar_index + 1, _bot, xloc=xloc.bar_index, extend=extend.right, color=_col, style=line.style_solid, width=1)
        array.set(_botLines, _slot, botLine)
    else
        line.set_xy1(botLine, bar_index, _bot)
        line.set_xy2(botLine, bar_index + 1, _bot)
        line.set_extend(botLine, extend.right)
        line.set_color(botLine, _col)
        line.set_style(botLine, line.style_solid)
        line.set_width(botLine, 1)
    if na(zoneFill)
        zoneFill := linefill.new(topLine, botLine, color.new(_col, 75))
        array.set(_fills, _slot, zoneFill)
    else
        linefill.set_color(zoneFill, color.new(_col, 75))

// Returns true when the candidate zone overlaps any already-drawn
// EMA crossover zone in price. Since existing zones extend.right,
// any later zone with overlapping price would visually overlap.
// First-drawn zones take precedence because overlapping new ones are skipped.
f_crossZoneOverlapsRegistry(_top, _bot) =>
    candidateTop = math.max(_top, _bot)
    candidateBot = math.min(_top, _bot)
    sz = array.get(crossZoneCountState, 0)
    hit = false
    if sz > 0
        for i = 0 to sz - 1
            existingTop = array.get(crossZoneTops, i)
            existingBot = array.get(crossZoneBots, i)
            priceRangeOverlaps = not na(existingTop) and not na(existingBot) and candidateBot <= existingTop and candidateTop >= existingBot
            if priceRangeOverlaps
                hit := true
    hit

// Returns true when the candidate zone overlaps any already-drawn
// trendline-intersection zone in price. Since existing zones extend.right,
// any later zone with overlapping price would visually overlap.
// First-drawn zones take precedence because overlapping new ones are skipped.
f_trendZoneOverlapsRegistry(_top, _bot) =>
    candidateTop = math.max(_top, _bot)
    candidateBot = math.min(_top, _bot)
    sz = array.get(trendIntersectionCountState, 0)
    hit = false
    if sz > 0
        for i = 0 to sz - 1
            existingTop = array.get(trendIntersectionTops, i)
            existingBot = array.get(trendIntersectionBots, i)
            priceRangeOverlaps = not na(existingTop) and not na(existingBot) and candidateBot <= existingTop and candidateTop >= existingBot
            if priceRangeOverlaps
                hit := true
    hit

f_trackCrossZone(_top, _bot, _col) =>
    registeredTop = math.max(_top, _bot)
    registeredBot = math.min(_top, _bot)
    slot = array.get(crossZoneSlotState, 0)
    count = array.get(crossZoneCountState, 0)
    f_drawPooledCrossZone(crossZoneTopLines, crossZoneBotLines, crossZoneFills, slot, _top, _bot, _col)
    array.set(crossZoneTops, slot, registeredTop)
    array.set(crossZoneBots, slot, registeredBot)
    array.set(crossZoneSlotState, 0, (slot + 1) % MAX_CROSS_ZONES)
    array.set(crossZoneCountState, 0, math.min(count + 1, MAX_CROSS_ZONES))

// Tracks a cross rectangle drawn while overlap-checking is disabled, so it
// can still be FIFO-cleaned once MAX_OVERLAP_ZONES is exceeded, without
// ever participating in overlap/proximity checks.
f_trackOverlappingCrossZone(_top, _bot, _col) =>
    slot = array.get(overlapZoneSlotState, 0)
    f_drawPooledCrossZone(overlapZoneTopLines, overlapZoneBotLines, overlapZoneFills, slot, _top, _bot, _col)
    array.set(overlapZoneSlotState, 0, (slot + 1) % MAX_OVERLAP_ZONES)

f_trackTrendIntersectionZone(_top, _bot, _col) =>
    registeredTop = math.max(_top, _bot)
    registeredBot = math.min(_top, _bot)
    slot = array.get(trendIntersectionSlotState, 0)
    count = array.get(trendIntersectionCountState, 0)
    f_drawPooledCrossZone(trendIntersectionTopLines, trendIntersectionBotLines, trendIntersectionFills, slot, _top, _bot, _col)
    array.set(trendIntersectionTops, slot, registeredTop)
    array.set(trendIntersectionBots, slot, registeredBot)
    array.set(trendIntersectionSlotState, 0, (slot + 1) % MAX_TREND_INTERSECTION_ZONES)
    array.set(trendIntersectionCountState, 0, math.min(count + 1, MAX_TREND_INTERSECTION_ZONES))

// Returns true when the candidate zone (_top/_bot) lies within _tolerance
// price distance of any already-drawn EMA crossover zone. This lets the
// user configure a minimum spacing (in price/tick terms) so that new
// rectangles are not drawn too close to existing ones, independent of
// the price-range overlap check performed by f_crossZoneOverlapsRegistry.
f_crossZoneWithinProximity(_top, _bot, _tolerance) =>
    candidateTop = math.max(_top, _bot)
    candidateBot = math.min(_top, _bot)
    sz  = array.get(crossZoneCountState, 0)
    hit = false
    if sz > 0 and _tolerance > 0
        for i = 0 to sz - 1
            existingTop = array.get(crossZoneTops, i)
            existingBot = array.get(crossZoneBots, i)
            // Distance between the candidate zone and the existing zone.
            // 0 when the ranges overlap, otherwise the gap between them.
            gap = not na(existingTop) and not na(existingBot) ? (candidateBot > existingTop ? candidateBot - existingTop : (existingBot > candidateTop ? existingBot - candidateTop : 0.0)) : na
            if not na(gap) and gap < _tolerance
                hit := true
    hit

// Draws a right-extended candle-origin zone on the first bar of a continuous
// ordered-band series. Bands are supplied from top to bottom; up to 8 bands are
// supported. The first na band ends the comparison list, so explicit trailing
// na arguments can be used for shorter definitions.
f_drawOrderedZone(color _col, float _band1, float _band2, float _band3, float _band4, float _band5, float _band6, float _band7, float _band8) =>
    activeBands = 0
    activeBands := not na(_band1) ? 1 : activeBands
    activeBands := activeBands == 1 and not na(_band2) ? 2 : activeBands
    activeBands := activeBands == 2 and not na(_band3) ? 3 : activeBands
    activeBands := activeBands == 3 and not na(_band4) ? 4 : activeBands
    activeBands := activeBands == 4 and not na(_band5) ? 5 : activeBands
    activeBands := activeBands == 5 and not na(_band6) ? 6 : activeBands
    activeBands := activeBands == 6 and not na(_band7) ? 7 : activeBands
    activeBands := activeBands == 7 and not na(_band8) ? 8 : activeBands

    orderOK = activeBands >= 2
    orderOK := orderOK and (activeBands < 2 or _band1 > _band2)
    orderOK := orderOK and (activeBands < 3 or _band2 > _band3)
    orderOK := orderOK and (activeBands < 4 or _band3 > _band4)
    orderOK := orderOK and (activeBands < 5 or _band4 > _band5)
    orderOK := orderOK and (activeBands < 6 or _band5 > _band6)
    orderOK := orderOK and (activeBands < 7 or _band6 > _band7)
    orderOK := orderOK and (activeBands < 8 or _band7 > _band8)

    firstInSeries = orderOK and not orderOK[1]
    peekPrice = orderedZonePeekUseWick ? high : math.max(open, close)
    peekOK = false
    peekOK := peekOK or (not na(_band1) and peekPrice > _band1)
    peekOK := peekOK or (not na(_band2) and peekPrice > _band2)
    peekOK := peekOK or (not na(_band3) and peekPrice > _band3)
    peekOK := peekOK or (not na(_band4) and peekPrice > _band4)
    peekOK := peekOK or (not na(_band5) and peekPrice > _band5)
    peekOK := peekOK or (not na(_band6) and peekPrice > _band6)
    peekOK := peekOK or (not na(_band7) and peekPrice > _band7)
    peekOK := peekOK or (not na(_band8) and peekPrice > _band8)
    peekRequirementMet = not orderedZonesRequirePeek or peekOK
    didDrawOrderedZone = false
    if firstInSeries and drawOrderedZones and peekRequirementMet
        innerA = activeBands <= 2 ? _band1 : activeBands <= 4 ? _band2 : activeBands <= 6 ? _band3 : _band4
        innerB = activeBands <= 2 ? _band2 : activeBands <= 4 ? _band3 : activeBands <= 6 ? _band4 : _band5
        _crossPrice = (innerA + innerB) / 2
        bodyTop = math.max(open, close)
        bodyBot = math.min(open, close)
        distHigh = math.abs(high - _crossPrice)
        distLow = math.abs(low - _crossPrice)
        distOpen = math.abs(open - _crossPrice)
        distClose = math.abs(close - _crossPrice)
        farthestWickIsHigh = distHigh >= distLow
        closestWickIsHigh = distHigh <= distLow
        farthestBody = distOpen >= distClose ? open : close
        closestBody = distOpen <= distClose ? open : close
        newTop = orderedRectangleOrigin == "Far Wick" ? math.max(farthestWickIsHigh ? high : low, farthestBody) : orderedRectangleOrigin == "Near Wick" ? math.max(closestWickIsHigh ? high : low, closestBody) : orderedRectangleOrigin == "High/Low" ? high : bodyTop
        newBot = orderedRectangleOrigin == "Far Wick" ? math.min(farthestWickIsHigh ? high : low, farthestBody) : orderedRectangleOrigin == "Near Wick" ? math.min(closestWickIsHigh ? high : low, closestBody) : orderedRectangleOrigin == "High/Low" ? low : bodyBot
        if drawCrossRectanglesOverlapping
            f_trackOverlappingCrossZone(newTop, newBot, _col)
            didDrawOrderedZone := true
        else
            if not f_crossZoneOverlapsRegistry(newTop, newBot) and not f_crossZoneWithinProximity(newTop, newBot, crossZoneProximityTicks * syminfo.mintick)
                f_trackCrossZone(newTop, newBot, _col)
                didDrawOrderedZone := true
    didDrawOrderedZone



if (drawOrderedZones)
    // Definitions for marking candles where K-bands appear in desired order (matched downwards). Eights inputs must be specified, so fill any used slots with the text string "na"

    //bandOrder1  = f_drawOrderedZone(color.new(#AD46FF, 0), K66Upper, K6Upper, K55Upper, K5Upper, na, na, na, na)
    //bandOrder2  = f_drawOrderedZone(color.new(#AD46FF, 0), K5Lower, K55Lower, K6Lower, K66Lower, na, na, na, na)
    //bandOrder3  = f_drawOrderedZone(color.new(#AD46FF, 0), K5Lower, K55Lower, K6Lower, K66Lower, na, na, na, na)

    //bandOrder4  = f_drawOrderedZone(color.new(#00E4E8, 0), K5Upper, K3Upper, na, na, na, na, na, na)
    //bandOrder5  = f_drawOrderedZone(color.new(#00E4E8, 0), K5Upper, K3Lower, na, na, na, na, na, na)
    //bandOrder6  = f_drawOrderedZone(color.new(#00E4E8, 0), K5Upper, K33Upper, na, na, na, na, na, na)
    //bandOrder7  = f_drawOrderedZone(color.new(#00E4E8, 0), K5Upper, K33Lower, na, na, na, na, na, na)

    //bandOrder8  = f_drawOrderedZone(color.new(#00E4E8, 0), K5Lower, K3Upper, na, na, na, na, na, na)
    //bandOrder9  = f_drawOrderedZone(color.new(#00E4E8, 0), K5Lower, K3Lower, na, na, na, na, na, na)
    //bandOrder10 = f_drawOrderedZone(color.new(#00E4E8, 0), K5Lower, K33Upper, na, na, na, na, na, na)
    //bandOrder11 = f_drawOrderedZone(color.new(#00E4E8, 0), K5Lower, K33Lower, na, na, na, na, na, na)

    //bandOrder12 = f_drawOrderedZone(color.new(#00E4E8, 0), K55Upper, K3Upper, na, na, na, na, na, na)
    //bandOrder13 = f_drawOrderedZone(color.new(#00E4E8, 0), K55Upper, K3Lower, na, na, na, na, na, na)
    //bandOrder14 = f_drawOrderedZone(color.new(#00E4E8, 0), K55Upper, K33Upper, na, na, na, na, na, na)
    //bandOrder15 = f_drawOrderedZone(color.new(#00E4E8, 0), K55Upper, K33Lower, na, na, na, na, na, na)

    //bandOrder16 = f_drawOrderedZone(color.new(#00E4E8, 0), K55Lower, K3Upper, na, na, na, na, na, na)
    //bandOrder17 = f_drawOrderedZone(color.new(#00E4E8, 0), K55Lower, K3Lower, na, na, na, na, na, na)
    //bandOrder18 = f_drawOrderedZone(color.new(#00E4E8, 0), K55Lower, K33Upper, na, na, na, na, na, na)
    //bandOrder19 = f_drawOrderedZone(color.new(#00E4E8, 0), K55Lower, K33Lower, na, na, na, na, na, na)

    //bandOrder20 = f_drawOrderedZone(color.new(#FFFFFF, 0), K5Upper, K55Upper, na, na, na, na, na, na)
    //bandOrder21 = f_drawOrderedZone(color.new(#FFFFFF, 0), K5Upper, K55Lower, na, na, na, na, na, na)
    //bandOrder22 = f_drawOrderedZone(color.new(#27EEF5, 0), K3Upper, K33Upper, na, na, na, na, na, na)
    //bandOrder23 = f_drawOrderedZone(color.new(#27EEF5, 0), K3Upper, K33Lower, na, na, na, na, na, na)

    bandOrder24 = f_drawOrderedZone(color.new(#FF0000, 0), K4Upper, K44Upper, na, na, na, na, na, na)
    bandOrder25 = f_drawOrderedZone(color.new(#FF0000, 0), K4Upper, K44Lower, na, na, na, na, na, na)

    bandOrder26 = f_drawOrderedZone(color.new(#FF0000, 0), K4Lower, K44Upper, na, na, na, na, na, na)
    bandOrder27 = f_drawOrderedZone(color.new(#FF0000, 0), K4Lower, K44Lower, na, na, na, na, na, na)




// Name kept for compatibility with the existing f_drawCrossBox(...) calls.
f_drawCrossBox(_cond, _col, _emaA, _emaB) =>
    _crossPrice = (_emaA + _emaB) / 2
    // Doji filter: skip drawing the box when the current candle's open-close
    // body is below the configured percentage of the candle's high-low range,
    // but only when filterDojiCrossBox is enabled.
    candleRangeCrossBox = high - low
    ocPctCrossBox = candleRangeCrossBox > 0 ? math.abs(close - open) / candleRangeCrossBox * 100.0 : 100.0
    isDojiCrossBox = filterDojiCrossBox and (ocPctCrossBox < crossBoxDojiOCpct)
    didDrawCrossBox = false
    if _cond and drawCrossRectangles and not isDojiCrossBox
        bodyTop = math.max(open, close)
        bodyBot = math.min(open, close)
        distHigh = math.abs(high - _crossPrice)
        distLow = math.abs(low - _crossPrice)
        distOpen = math.abs(open - _crossPrice)
        distClose = math.abs(close - _crossPrice)
        farthestWickIsHigh = distHigh >= distLow
        closestWickIsHigh = distHigh <= distLow
        farthestBody = distOpen >= distClose ? open : close
        closestBody = distOpen <= distClose ? open : close
        newTop = crossRectangleOrigin == "Far Wick" ? math.max(farthestWickIsHigh ? high : low, farthestBody) : crossRectangleOrigin == "Near Wick" ? math.max(closestWickIsHigh ? high : low, closestBody) : crossRectangleOrigin == "High/Low" ? high : bodyTop
        newBot = crossRectangleOrigin == "Far Wick" ? math.min(farthestWickIsHigh ? high : low, farthestBody) : crossRectangleOrigin == "Near Wick" ? math.min(closestWickIsHigh ? high : low, closestBody) : crossRectangleOrigin == "High/Low" ? low : bodyBot
        if drawCrossRectanglesOverlapping
            // Overlap checking disabled: draw the rectangle unconditionally.
            // It is NOT registered in the overlap/proximity tracking arrays,
            // so it never blocks (or is blocked by) other cross rectangles.
            // It uses a separate fixed-size reusable pool so drawing limits
            // cannot be exceeded by repeated line/linefill creation.
            f_trackOverlappingCrossZone(newTop, newBot, _col)
            didDrawCrossBox := true
        else
            if not f_crossZoneOverlapsRegistry(newTop, newBot) and not f_crossZoneWithinProximity(newTop, newBot, crossZoneProximityTicks * syminfo.mintick)
                f_trackCrossZone(newTop, newBot, _col)
                didDrawCrossBox := true
    didDrawCrossBox


// DEFINITIONS
// f_drawCrossBox(crossEMAK1K2 and showBoxK1K2, ema1crosscolour, K1EMA, K2EMA)
f_drawCrossBox(crossEMAK1K11 and showBoxK1K11, emaK1K11crosscolour, K1EMA, K11EMA)
